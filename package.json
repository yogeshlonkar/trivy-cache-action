{
  "name": "trivy-cache-action",
  "version": "1.0.0",
  "private": true,
  "description": "Cache .trivy directory using trivy db version sha",
  "main": "dist/restore/index.js",
  "scripts": {
    "all": "npm run format && npm run lint && npm test && npm run build",
    "build": "rm -rf dist && ncc build --source-map --license licenses.txt -o dist/restore src/restore.ts && ncc build --source-map --license licenses.txt -o dist/save src/save.ts && scripts/check-bundle.sh",
    "test": "tsc --noEmit && jest --coverage",
    "lint": "eslint . --cache --fix",
    "lint-check": "eslint . --cache",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "check-dist": "scripts/check-dist.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogeshlonkar/trivy-cache-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "trivy",
    "trivy-db",
    "cache"
  ],
  "author": "yogeshlonkar",
  "license": "MIT",
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@actions/cache": "^6.0.0",
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/http-client": "^4.0.0",
    "@actions/io": "^3.0.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.51.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jest": "^30.2.0",
    "jest-circus": "^30.2.0",
    "nock": "^14.0.11",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.3"
  }
}
